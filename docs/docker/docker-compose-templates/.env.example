POSTGRES_PASSWORD=change_me_pg
POSTGRES_PORT=5432

MYSQL_DB=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_PORT=3306

REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# 2. Monolith Stack
HTTP_PORT=80
MONO_APP_PORT=8080
MONO_DB_NAME=monolith_db
MONO_DB_USER=mono_user
MONO_DB_PASSWORD=change_me_mono

# 3. Microservices Stack
GATEWAY_PORT=80
JWT_SECRET=super_secret_jwt_key_change_me
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth
USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me_user
ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=change_me_order
RABBITMQ_USER=ms_broker
RABBITMQ_PASS=change_me_rabbit

# 4. Distributed Stack
LB_PORT=80
API_REPLICAS=2
WORKER_REPLICAS=2
DIST_DB_NAME=distributed_db
DIST_DB_USER=dist_user
DIST_DB_PASSWORD=change_me_dist
PROMETHEUS_PORT=9090
